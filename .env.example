# ─────────────────────────────────────────────────────────────
#  VALLÉ WHATSAPP BOT — ENVIRONMENT
#  Copy to .env and fill in. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# --- Server ---
PORT=3000
NODE_ENV=production

# --- Meta / WhatsApp Cloud API ---
# From: developers.facebook.com > Your App > WhatsApp > API Setup
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WABA_ID=
GRAPH_API_VERSION=v24.0

# You invent this string. Paste the SAME value into Meta's webhook config screen.
VERIFY_TOKEN=

# From: Meta App Dashboard > App Settings > Basic > App Secret
# Used to verify the X-Hub-Signature-256 header so nobody can fake webhooks.
APP_SECRET=

# The business number in international format, digits only (for wa.me links / QR)
BUSINESS_NUMBER=23052928841

# --- 360dialog (coexistence gateway for the main number) ---
# Paste the D360-API-KEY from app.360dialog.com once the number is onboarded.
# When set, the bot sends/receives through 360dialog instead of Meta directly.
D360_API_KEY=

# --- Voice notes (optional) ---
# OpenAI key enables voice-note transcription via Whisper (~$0.006/min, all languages).
# Get one at platform.openai.com. Empty = voice notes are handed to the team.
OPENAI_API_KEY=

# --- Anthropic (the AI brain) ---
# From: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
# claude-sonnet-5 = best quality. claude-haiku-4-5-20251001 = cheapest/fastest at volume.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=700

# --- Postgres ---
DATABASE_URL=postgres://valle:password@localhost:5432/valle_bot
# Set to "true" on Render/Heroku/Neon/Supabase, "false" for local docker
DB_SSL=false

# Secret key for the read-only web dashboard: /dashboard?key=<this value>
# Anyone with the full link can view stats and conversations - keep it private.
DASHBOARD_KEY=

# --- Bot behaviour ---
# menu   = simple keyword/button bot: fixed replies from the ATM 2026 pack, no AI.
# hybrid = buttons & price cards first, AI answers anything typed freely. (recommended)
# ai     = Claude AI concierge for everything.
BOT_MODE=hybrid

# true  = bot only replies to people who scanned a QR code (their first message
#         matches one of the QR prefilled texts). Everyone else is stored in the
#         database but gets NO reply.
# false = bot replies to anyone who messages the number.
QR_ONLY=true

# Numbers (digits only, with country code) allowed to use the WhatsApp back office.
# Comma separated. These are your staff.
ADMIN_NUMBERS=23052928841,23057654321

# Minutes of agent silence before a human-handled chat auto-returns to the bot
HANDOVER_TIMEOUT_MIN=30

# Minutes of colleague silence before a chat a HUMAN is handling goes back to the
# bot. 0 (recommended) = never: once a colleague replies to a guest, from the
# WhatsApp Business app or with #claim, the bot stays out of that conversation
# until someone releases it with #release.
HUMAN_TAKEOVER_MINUTES=0

# Business hours in park local time. Decimals allowed: 17.5 means 17:30.
OPEN_HOUR=9
CLOSE_HOUR=17.5
TIMEZONE=Indian/Mauritius

# Name of the approved template used to ping an agent when the 24h window has closed.
# Leave blank until you have created & had it approved in WhatsApp Manager.
AGENT_ALERT_TEMPLATE=agent_alert
AGENT_ALERT_TEMPLATE_LANG=en

# ─────────────────────────────────────────────────────────────────────────────
#  SMS — Twilio (optional)
# ─────────────────────────────────────────────────────────────────────────────
# When a guest scans the ATM Dubai QR code, a short text about the park reaches
# their phone as well (WELCOME_SMS in src/notify/sms.js: one segment, sent
# once). Leave the credentials blank and no SMS is ever sent.
#
#   1. console.twilio.com → Account Info: copy the Account SID and Auth Token.
#   2. Messaging → Settings → Geo permissions: tick every destination country.
#      By default only the sign-up country is allowed (error 21408 otherwise),
#      and this cannot be done through the API.
#   3. Buy one SMS-capable number (a US local number needs no paperwork):
#        node scripts/twilio-setup.js numbers US    then    buy +1… --yes
#      and put it in TWILIO_FROM. Keep TWILIO_ALPHA_SENDER=Valle so guests in
#      Mauritius, Réunion, the UK, France, Germany, Italy, Ukraine, Bahrain,
#      Egypt, Pakistan and Kenya see the park's name instead of a number.
#   4. The UAE, Saudi Arabia, Qatar and Kuwait only deliver sender IDs
#      registered with their operators (2–4 weeks, no Twilio fee): Numbers and
#      Senders → Alphanumeric senders → Set up a new alphanumeric sender ID
#      (UAE wants an "AD-" prefix for marketing, Saudi an "-AD" suffix). Until
#      then those guests are skipped and WhatsApp still answers them; afterwards
#      set SMS_SKIP_COUNTRIES to what remains, e.g. 7,90,1.
#   5. node scripts/twilio-setup.js status    then    test +230…   to watch one land.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The park's name as the sender: 11 characters at most, letters and digits.
TWILIO_ALPHA_SENDER=Valle
# A Twilio number in E.164, the sender wherever a name is not accepted.
TWILIO_FROM=
# Optional: a Messaging Service that chooses the sender itself (registered
# sender IDs live there). When set it is used instead of the two above.
TWILIO_MESSAGING_SERVICE_SID=
# Dial prefixes never texted, comma separated. Empty = the built-in list
# (971 UAE, 966 Saudi, 974 Qatar, 965 Kuwait, 7 Russia, 90 Turkey, 86 China,
# 1 USA and Canada); "none" = text everyone.
SMS_SKIP_COUNTRIES=
# Set to false to stop sending SMS without removing the credentials.
SMS_ENABLED=true
# Where the bot is reachable, for Twilio's delivery reports. Railway provides
# its own domain automatically; set this only when hosted elsewhere.
PUBLIC_URL=

# ─────────────────────────────────────────────────────────────────────────────
#  EMAIL — Resend (optional)
# ─────────────────────────────────────────────────────────────────────────────
# The bot offers the illustrated park overview by email and sends the PDF.
# Leave RESEND_API_KEY blank and the bot never offers or sends email.
#
#   1. resend.com -> API Keys -> Create (starts with re_)
#   2. Domains -> Add domain -> add the SPF, DKIM and DMARC records it shows you
#      to the Vallé DNS. Without them the mail lands in spam.
#   3. EMAIL_FROM must use that verified domain.
RESEND_API_KEY=
EMAIL_FROM=Vallé Advenature Park <marketing@vallepark.com>
# Replies from guests go here. Use the reservations mailbox.
EMAIL_REPLY_TO=sales@vallepark.com
# Comma separated. CC is visible to the guest (the sales desk); BCC is not.
EMAIL_CC=sales@vallepark.com
EMAIL_BCC=abdurrahman@vallepark.com,ashfaaq@vallepark.com
